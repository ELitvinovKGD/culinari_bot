# --- Секреты ---
# Настоящие токены и пароли. В Git идёт только .env.example с пустыми значениями.
.env
.env.*
!.env.example

# --- Python: создаётся автоматически ---
__pycache__/
*.py[cod]

# Виртуальное окружение: пересоздаётся из списка зависимостей
.venv/
venv/

# --- Тесты и проверки кода ---
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Резервные копии базы и логи ---
# В дампах телефоны и адреса клиентов — в Git им точно не место
backups/
*.dump
*.sql.gz
logs/
*.log

# --- Редакторы ---
.vscode/
.idea/

# --- Windows ---
Thumbs.db
desktop.ini

# --- Docs notes были только для меня ---
docs/notes/