# Шаблон настроек бота.
# Скопируй этот файл в .env и заполни значения:
#     copy .env.example .env      (Windows PowerShell: Copy-Item .env.example .env)
# Файл .env в Git не попадает (см. .gitignore) — в нём настоящие секреты.

# Токен бота от @BotFather. Это пароль от бота: кто его знает, тот управляет ботом.
BOT_TOKEN=

# Твой Telegram ID — первый администратор, его нельзя удалить через бота.
# Узнать свой ID: написать боту @userinfobot.
OWNER_TG_ID=

# Пароль базы данных. Используется и контейнером PostgreSQL, и ботом.
# Придумай любой длинный пароль.
POSTGRES_PASSWORD=change-me

# Адрес базы (DATABASE_URL) здесь не задаём: docker-compose.yml собирает его
# сам из POSTGRES_PASSWORD. Задавать его вручную нужно, только если запускаешь
# бота без Docker, например:
# DATABASE_URL=postgresql+asyncpg://culinary:пароль@localhost:5432/culinary

# Часовой пояс для показа времени (по умолчанию Черногория).
# TIMEZONE=Europe/Podgorica

# Минут на «✏️ Изменить заказ» после оформления (по умолчанию 10).
# ORDER_EDIT_MINUTES=10

# Подробность журнала: DEBUG (всё), INFO (обычно), WARNING (только проблемы).
LOG_LEVEL=INFO
